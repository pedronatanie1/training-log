@TrainingLog.Api_HostAddress = http://localhost:5097

GET {{TrainingLog.Api_HostAddress}}/api/exercises
Accept: application/json

###

GET {{TrainingLog.Api_HostAddress}}/api/muscle-groups
Accept: application/json

###

# 1. Empty name: expect 400 "Exercise name is required."
POST {{TrainingLog.Api_HostAddress}}/api/exercises
Content-Type: application/json

{ "name": "", "muscleGroupId": 1 }

###

# 2. Valid: expect 201 Created
POST {{TrainingLog.Api_HostAddress}}/api/exercises
Content-Type: application/json

{ "name": "Cable Fly", "muscleGroupId": 1 }

###

# 3. Same name again: expect 400 "already exists"
POST {{TrainingLog.Api_HostAddress}}/api/exercises
Content-Type: application/json

{ "name": "Cable Fly", "muscleGroupId": 1 }

###

# 4. Muscle group that doesn't exist: expect 400
POST {{TrainingLog.Api_HostAddress}}/api/exercises
Content-Type: application/json

{ "name": "Test", "muscleGroupId": 999 }

###
